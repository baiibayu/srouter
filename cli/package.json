{
  "name": "@baiibayu/srouter",
  "version": "0.1.13",
  "description": "SRouter — free open-source LLM router: run the gateway, set up coding agents, manage provider keys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiibayu/srouter.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/baiibayu/srouter/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/baiibayu/srouter/issues"
  },
  "keywords": [
    "srouter",
    "llm",
    "llm-router",
    "gateway",
    "openai-compatible",
    "claude-code",
    "codex",
    "aider",
    "cline",
    "coding-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "srouter": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/config-files.js",
    "dist/config-files.d.ts",
    "dist/mcp.js",
    "dist/mcp.d.ts",
    "dist/doctor.js",
    "dist/doctor.d.ts",
    "dist/keys.js",
    "dist/keys.d.ts",
    "dist/models.js",
    "dist/models.d.ts",
    "dist/serve.js",
    "dist/serve.d.ts",
    "dist/tools.js",
    "dist/tools.d.ts",
    "dist/update-check.js",
    "dist/update-check.d.ts",
    "dist/update.js",
    "dist/update.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "tools.json",
    "server",
    "client",
    "desktop/package.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node ../scripts/prepare-cli-pack.mjs",
    "postpack": "node ../scripts/prepare-cli-pack.mjs --clean"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonc-parser": "^3.3.1",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.0.0",
    "undici": "^6.21.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.12.2",
    "typescript": "~6.0.2",
    "vitest": "^3.1.3",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.0"
  }
}
